# File path for the self-hosted SQLite database. This file must live on persistent storage.
VERITAS_DATABASE_FILE=./data/veritas.db

# Required before saving provider keys in the dashboard: base64 for exactly 32 random bytes.
# Generate: openssl rand -base64 32
VERITAS_ENCRYPTION_KEY=

# Required to enable the local owner dashboard at /settings. Use a long unique value.
VERITAS_ADMIN_PASSWORD=

# Optional environment-based provider credentials. Dashboard credentials take precedence per provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
BRAVE_SEARCH_API_KEY=
NEWSAPI_KEY=
GUARDIAN_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
